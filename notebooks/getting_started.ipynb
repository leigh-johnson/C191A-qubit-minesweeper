   "source": [
    "You can also make 3-D diagrams of the circuit, using `timeline-3d`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 111,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/",
